.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding-bottom: 40rpx;
  box-sizing: border-box;
  overflow-x: hidden;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.nav-bar {
  position: relative;
  z-index: 100;
  padding-top: env(safe-area-inset-top);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1a1a2e;
}

/* 可滚动内容区域 */
.content-scroll {
  flex: 1;
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
}

.nav-back {
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  height: 100%;
}

.back-icon {
  font-size: 48rpx;
  color: #fff;
  font-weight: bold;
}

.back-text {
  font-size: 28rpx;
  color: #fff;
  margin-left: 4rpx;
}

.nav-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-placeholder {
  width: 120rpx;
}

/* 顶部标题 */
.header {
  padding: 16rpx 40rpx 8rpx;
}

.header-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
}

.header-subtitle {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* Tab切换 */
.tab-bar {
  display: flex;
  margin: 0 40rpx 24rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50rpx;
  padding: 6rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
  border-radius: 50rpx;
  transition: all 0.3s;
}

.tab-item.active {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: #fff;
}

/* 内容区域 */
.content {
  padding: 0 40rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 24rpx;
}

/* 饮食方法列表 */
.methods-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.method-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx;
  padding-right: 60rpx; /* 增加右padding，为箭头留出空间 */
  display: flex;
  align-items: center;
  transition: all 0.3s;
  border: 2rpx solid transparent;
  box-sizing: border-box; /* 确保padding不会撑开宽度 */
}

.method-card.selected {
  border-color: #667eea;
  background: rgba(102, 126, 234, 0.15);
}

.method-icon {
  font-size: 44rpx;
  margin-right: 24rpx;
}

.method-info {
  flex: 1;
}

.method-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 6rpx;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.method-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.method-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.4);
  transition: transform 0.3s;
}

.method-arrow.rotated {
  transform: rotate(90deg);
}

/* 方法详情 */
.method-detail {
  margin-top: 24rpx;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 20rpx;
  padding: 28rpx;
  box-sizing: border-box;
  width: 100%;
}

.detail-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 20rpx;
}

.detail-section {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  margin: 20rpx 0 10rpx;
}

.detail-text {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
  line-height: 1.7;
  word-wrap: break-word; /* 确保长文字自动换行 */
  overflow-wrap: break-word;
}

/* 推荐方案列表 */
.plans-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.plan-card {
  background: rgba(255, 255, 255, 0.08);
  border-radius: 20rpx;
  padding: 28rpx;
  padding-right: 70rpx; /* 增加右padding，为箭头留出空间 */
  position: relative;
  transition: all 0.3s;
  box-sizing: border-box; /* 确保padding不会撑开宽度 */
}

.plan-card:active {
  transform: scale(0.98);
}

.plan-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.plan-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.plan-calories {
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
}

.plan-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.6);
  line-height: 1.5;
  margin-bottom: 16rpx;
  word-wrap: break-word;
  overflow-wrap: break-word;
}

.plan-macros {
  display: flex;
  gap: 32rpx;
}

.macro-item {
  text-align: center;
}

.macro-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #fff;
}

.macro-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.5);
  margin-top: 4rpx;
}

.plan-arrow {
  position: absolute;
  right: 28rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.4);
}

/* 详情弹窗 */
.detail-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  display: flex;
  align-items: flex-end;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.3s;
}

.detail-modal.show {
  opacity: 1;
  pointer-events: auto;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.7);
}

.modal-content {
  position: relative;
  width: 100%;
  max-height: 80vh;
  background: linear-gradient(180deg, #1e2a4a 0%, #1a1a2e 100%);
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  box-sizing: border-box;
  overflow-x: hidden;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 32rpx 40rpx 20rpx;
  border-bottom: 1rpx solid rgba(255, 255, 255, 0.1);
}

.modal-title {
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.modal-close {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
  color: rgba(255, 255, 255, 0.6);
  background: rgba(255, 255, 255, 0.1);
  border-radius: 50%;
}

.modal-body {
  max-height: calc(80vh - 100rpx);
  padding: 28rpx 40rpx 48rpx;
}

/* 热量显示 */
.calories-row {
  display: flex;
  align-items: baseline;
  justify-content: center;
  margin-bottom: 28rpx;
}

.calories-value {
  font-size: 64rpx;
  font-weight: bold;
  color: #667eea;
}

.calories-unit {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
  margin-left: 12rpx;
}

/* 宏量营养素图表 */
.macros-chart {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.macro-bar {
  display: flex;
  flex-direction: column;
}

.macro-bar-bg {
  height: 16rpx;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 8rpx;
  overflow: hidden;
  margin-bottom: 8rpx;
}

.macro-bar-fill {
  height: 100%;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.macro-bar-fill.macro-0 {
  background: linear-gradient(90deg, #667eea 0%, #764ba2 100%);
}

.macro-bar-fill.macro-1 {
  background: linear-gradient(90deg, #f093fb 0%, #f5576c 100%);
}

.macro-bar-fill.macro-2 {
  background: linear-gradient(90deg, #4facfe 0%, #00f2fe 100%);
}

.macro-bar-info {
  display: flex;
  justify-content: space-between;
  font-size: 24rpx;
}

.macro-name {
  color: rgba(255, 255, 255, 0.8);
}

.macro-num {
  color: rgba(255, 255, 255, 0.5);
}

/* 餐单列表 */
.detail-section-block {
  margin-bottom: 32rpx;
}

.section-header {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
  padding-bottom: 14rpx;
  border-bottom: 2rpx solid rgba(255, 255, 255, 0.1);
}

.meals-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.meal-item {
  display: flex;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 16rpx;
  padding: 20rpx;
}

.meal-time {
  font-size: 26rpx;
  color: #667eea;
  font-weight: bold;
  min-width: 96rpx;
  padding-right: 20rpx;
  border-right: 2rpx solid rgba(102, 126, 234, 0.3);
  margin-right: 20rpx;
}

.meal-name {
  font-size: 26rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.meal-foods {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  max-width: 100%; /* 确保不会超出父容器 */
}

.food-tag {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.8);
  background: rgba(102, 126, 234, 0.2);
  padding: 6rpx 14rpx;
  border-radius: 30rpx;
  white-space: normal; /* 确保文字可以换行 */
  word-wrap: break-word;
}

/* 提示列表 */
.tips-list {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.tip-item {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}
