.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  padding: 32rpx 40rpx 40rpx;
  box-sizing: border-box;
  overflow-x: hidden;
}

.header {
  margin-bottom: 40rpx;
}

.welcome-text {
  font-size: 44rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.subtitle {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.6);
}

.feature-cards {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.feature-card {
  background: linear-gradient(135deg, rgba(102, 126, 234, 0.3) 0%, rgba(118, 75, 162, 0.3) 100%);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(102, 126, 234, 0.3);
}

.feature-card.workout-card {
  background: linear-gradient(135deg, rgba(255, 107, 107, 0.3) 0%, rgba(255, 159, 128, 0.3) 100%);
  border-color: rgba(255, 107, 107, 0.3);
}

.card-icon {
  font-size: 64rpx;
  margin-right: 28rpx;
}

.card-content {
  flex: 1;
}

.card-title {
  font-size: 36rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 10rpx;
}

.card-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.7);
}

.card-arrow {
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.5);
}

.quick-stats {
  display: flex;
  justify-content: space-around;
  align-items: center;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 36rpx 24rpx;
  margin-bottom: 40rpx;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 52rpx;
  font-weight: bold;
  color: #667eea;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

.stat-divider {
  width: 1rpx;
  height: 60rpx;
  background: rgba(255, 255, 255, 0.1);
}

.tips-section {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 24rpx;
  padding: 32rpx;
  border-left: 6rpx solid #667eea;
}

.tips-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.tips-content {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.7);
  line-height: 1.6;
}
