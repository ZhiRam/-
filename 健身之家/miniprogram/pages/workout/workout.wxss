.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a2e 0%, #16213e 100%);
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

/* 自定义导航栏 */
.nav-bar {
  position: relative;
  z-index: 100;
  padding-top: env(safe-area-inset-top);
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #1a1a2e;
}

.nav-title {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  font-size: 34rpx;
  font-weight: bold;
  color: #fff;
}

.nav-back {
  position: fixed;
  top: calc(env(safe-area-inset-top) + 5vh);
  left: 24rpx;
  display: flex;
  align-items: center;
  z-index: 101;
}

.back-icon {
  font-size: 36rpx;
  color: #fff;
  font-weight: bold;
}

.back-text {
  font-size: 28rpx;
  color: #fff;
  margin-right: 4rpx;
}

/* 可滚动内容区域 */
.content-scroll {
  flex: 1;
  height: calc(100vh - 88rpx - env(safe-area-inset-top));
}

/* 顶部标题 */
.header {
  padding: 40rpx 40rpx 50rpx;
  text-align: center;
}

.header-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 12rpx;
}

.header-subtitle {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.6);
}

/* 肌群卡片网格 */
.muscle-grid {
  padding: 0 40rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.muscle-card {
  position: relative;
  height: 200rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.3);
}

.card-bg {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  opacity: 0.9;
}

.card-content {
  position: relative;
  z-index: 1;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 40rpx;
}

.card-icon {
  font-size: 64rpx;
  margin-bottom: 8rpx;
}

.card-name {
  font-size: 40rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 8rpx;
}

.card-count {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}

.card-arrow {
  position: absolute;
  right: 40rpx;
  top: 50%;
  transform: translateY(-50%);
  font-size: 48rpx;
  color: rgba(255, 255, 255, 0.6);
}

.muscle-card:active {
  transform: scale(0.98);
  opacity: 0.9;
}
